#
# ********************************************************************
#
#   File: Makefile.osx
#
#   Developer: rdodds
#
#   Last modifications: April 17, 2026 rhd  (build number 5110)
#
#       Builds executables for:
#
#       -  Apple silicon computers using gfortran, Accelerate framework
#       -  Apple Intel computers using ifort, MKL (Ventura and earlier)
#       -  Apple Intel computers using gfortran, MKL (Ventura and earlier)
#
#          gfortran 15.2 using for current builds
#
#    Invoke this makefile with (# = number of concurrent compiles):
#
#          make -j # f  Makefile.osx PLATFORM=silicon
#          make -j # f  Makefile.osx PLATFORM=Intel_ifort
#          make -j # f  Makefile.osx PLATFORM=Intel_gfortran
#
#    WARP3D no longer supports MPI on any platform (from January 2026) 
#
#    The MUMPS and NASA-VSS solvers are now also available on all
#    platforms (from January 2026).
#         On Intel, MUMPS and other parts of WARP3D use the 
#             LAPACK/BLAS routines in MKL
#          On Apple silicon, MUMPS and and other parts of WARP3D use 
#             the LAPACK/BLAS routines in the Accelerate framework
#
#    The Intel builds use Ventura 13.6 with Intel ifort 2021.10.0
#        and Intel MKL 2023.1 20230303 
#    The Silicon builds on Tahoe 2026. 
#
#
#     
#    Notes for Intel platform w/ ifort (Fortran Classic)
#    ===================================================
#
#     Build OMP version of WARP3D (64-bit) running on
#     macOS Ventura, Intel processors.
#
#     Build with Intel (Classic) Fortran: ifort
#     Links with the (free) Intel MKL library to access the PARDISO
#     solver and LAPACK/BLAS routines
#     Includes MUMPS solver with Intel MKL library to access LAPACK/BLAS routines
#
#     Build tested with: macOS Ventura 13.6
#     Intel ifort 2021.10.0
#     Intel MKL 2023.1 20230303 (included with WARP3D distribution)
#
#     How we handle MKL libraries--
#
#     The few required libraries are
#     included in the WARP3D directory OSX_MKL_files.
#     The build instructions below explicitly link these static
#     libraries. Users of WARP3D on Mac (Intel) computers can thus 
#     run w/o the Intel compiler system installed.
#
#     Notes
#
#       1. Key compiler options:
#           Intel: by default we use the compiler feature to
#                  build instructions in the executable for all
#                  processor types from ivybridge to current.
#                  During execution the code dispatches the best
#                  instructions for your specific computer.
#
#                  A smaller executable file can be generated using
#                  -xHOST option as offered below
#
#       2. The Pardiso solver package in Intel MKL automatically
#          uses the most efficient instruction set available on
#          your specific computer.
#
#       3. The distributed executables for WARP3D ** requires ** 
#          that your processor support the AVX instruction 
#          set from Intel ivybridge and newer processors
#          (as a minimum).
#
#          These processors became available in early 2011 and include:
#             2nd Generation Intel® Core™ i7 Processors
#             2nd Generation Intel® Core™ i5 Processors
#             2nd Generation Intel® Core™ i3 Processors
#             Intel® Xeon® Processor E5 Family
#             Intel® Xeon® Processor E3 Family
#             + all newer processors
#
#           During the next year, we plan to require processors
#           that support the AVX2 instruction set.
#
#       3. We build a static executable including MKL and threads
#          support libraries.
#
#       We ** strongly ** recommend you re-build the executable to leverage
#       all features of newer x86-64 processors: use the 
#       HARDWARE_SPECIFIC option set rather than the ALL_PROCESSORS set
#       defined below.
#
#    Notes for Apple Silicon
#    =======================
#
#     Build OMP version of WARP3D (64-bit) running on
#     macOS Apple Silicon processors.
#
#     Use gfortran targeted to M1 processors which will work
#     on M2, M3, M4, M5...  
#     You can build a processor specific version by adjusting
#     the HARDWARE_SPECIFIC and MACHINE_TYPE variables.
#
#     Current (March 2026) built with gfortran 15.2 which recognizes
#     M1, M2 and M3.
#
#     We use thew MUMPS solver compiled with gfortran for M1. 
#     Benchmarking shows no advantage of M2, M3.
#
#     MUMPS relies on BLAS routines for performance. We link 
#     with the Apple provided veclib in Accelerate to use that
#     BLAS library.
#
# ***********************************************************************
#
OSNAME   := OSX
BUILDNUM := 5110 
NO_INLINE = 
#
#              setup for macOS, Intel x86-64, ifort
#              ====================================
# 
ifeq ($(PLATFORM),Intel_ifort)
    ODIR = ././../obj_macOS_ifort
    EXE_NAME = warp3d_Intel.exe
    BUILD_FLAG :=  $(BUILDNUM)
    KMP_ERROR  := KMP_ERROR  # temp fix for MKL 
    MKL := MKL  # include MKL routines
    PARDISO := PARDISO
    O        = .o
    OD       = $(ODIR)
    RMC      = rm -f
    MVC      = mv -f
    COMPILER = ifort 
    OPENMP   = -qopenmp -reentrancy 
    FTRAP    =
    OPT_REPORT = -qopt-report-annotate=html  -qopt-report-file=zz -qopt-report=5
    OPT_REPORT =
    NO_INLINE   = -inline-level=0
    INLINE   = -no-inline-factor
    PROFILE  = -pg
    PROFILE  = 
    CHECKFLOAT = -init=snan,arrays -fp-speculation=safe 
    CHECKFLOAT = -fp-speculation=safe
    CHECKOTHER = -check bounds,pointers,uninit
    CHECKOTHER = 
#
    OSX_LIBDIR = ../OSX_MKL_files
    MUMPS_LIB  = ../MUMPS_libs/libmumps_all_ifort_osx_Intel_metis.a
    METIS_LINK = -L../MUMPS_libs -lmetis -Wl,-rpath,@loader_path/../MUMPS_lib           
    LINKOPS2  = -static-intel -qopenmp-link=static \
                ${OSX_LIBDIR}/libiomp5.a \
                ${OSX_LIBDIR}/libmkl_intel_lp64.a \
                ${OSX_LIBDIR}/libmkl_intel_thread.a \
                ${OSX_LIBDIR}/libmkl_core.a
    LINKOPS   = $(LINKOPS2) $(MUMPS_LIB)  $(METIS_LINK)#-Wl,-ld_classic  # classic loader 
    ALL_PROCESSORS = -axAVX,CORE-AVX2 -xIVYBRIDGE \
                       -align array64byte  -qopt-zmm-usage=high
    HARDWARE_SPECIFIC = -xHOST  -align array64byte  -qopt-zmm-usage=high
    MACHINE_TYPE = $(ALL_PROCESSORS) # $(HARDWARE_SPECIFIC)
#
    FCOPTS   =  -O3 -fpp -fpconstant -fixed -72 -traceback $(PROFILE) \
                $(OPT_REPORT) -module $(ODIR) -ftz  $(MACHINE_TYPE) \
                $(FTRAP) $(INLINE) $(OPENMP) $(CHECKFLOAT) $(CHECKOTHER) \
                -mmacosx-version-min=11.5
#
    FOR      = $(COMPILER) $(FCOPTS) -D$(MKL) -D$(KMP_ERROR) -D$(OSNAME) \
               -D$(PARDISO) -DBuild=$(BUILDNUM)
    LINK     = $(COMPILER) $(FCOPTS)  $(OBJ)  $(LINKOPS)
    POST_LINK =
    POST_LINK_SIGN = 
#
endif
#
#              setup for macOS, Intel x86-64, gfortran
#              =======================================
# 
ifeq ($(PLATFORM),Intel_gfortran)
#
    ODIR = ././../obj_macOS_Intel_gfortran
    OD   = ././../obj_macOS_Intel_gfortran
    EXE_NAME = warp3d_Intel_gfortran.exe
    MKL := MKL  # include MKL routines
    PARDISO := 
    O        = .o
    RMC      = rm -f
    MVC      = mv -f
#
    COMPILER = gfortran
#
    OSX_LIBDIR = ../OSX_MKL_files
    MUMPS_LIB  = ../MUMPS_libs/libmumps_all_gfort_osx_Intel_metis.a
    MKL_THREADED_LIST=   $(OSX_LIBDIR)/libiomp5.a \
                         $(OSX_LIBDIR)/libmkl_intel_lp64.a \
                         $(OSX_LIBDIR)/libmkl_intel_thread.a \
                         $(OSX_LIBDIR)/libmkl_core.a 
    METIS_LINK=-L../MUMPS_libs -lmetis -Wl,-rpath,@loader_path/../MUMPS_lib           
#                         
    ALL_PROCESSORS = -march=x86-64-v3 -mtune=generic
    HARDWARE_SPECIFIC = -march=native -mtune=native
    MACHINE_TYPE =  $(ALL_PROCESSORS) # $(HARDWARE_SPECIFIC)
#        
    PRODUCTION = -DOSX -DBuild=$(BUILDNUM) -Dgfortran -DMKL -I$(OD) -J$(OD) \
      -O3 -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=overflow,zero -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
      $(MACHINE_TYPE)
#   
    DEBUG1 = -DOSX -DBuild=$(BUILDNUM) -Dgfortran -DMKL -I$(OD) -J$(OD) \
      -O0 -g -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=invalid,zero,overflow -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
       -finit-real=snan -finit-integer=-999999  \
       $(MACHINE_TYPE)
#   
    DEBUG2 = -DOSX -DBuild=$(BUILDNUM) -Dgfortran -DMKL -I$(OD) -J$(OD) \
      -O0 -g -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=overflow,zero -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
       -finit-real=snan -finit-integer=-999999  \
       $(MACHINE_TYPE)
#
    OPTS = $(PRODUCTION)  -D$(OSNAME)
    FOR      = $(COMPILER) $(OPTS)
    LDWARN = -Wl,-w
    STATIC_LIBS = -static-libquadmath -static-libgfortran 
    LINK = $(COMPILER) $(OPTS) $(OBJ) $(MUMPS_LIB)  $(MKL_THREADED_LIST) \
        $(STATIC_LIBS) $(METIS_LINK) $(LDWARN)
    POST_LINK = \
    install_name_tool -delete_rpath /usr/local/Cellar/gcc/15.2.0_1/lib/gcc/current/gcc/x86_64-apple-darwin22/15 $@ 2>/dev/null || true; \
    install_name_tool -delete_rpath /usr/local/Cellar/gcc/15.2.0_1/lib/gcc/current/gcc $@ 2>/dev/null || true; \
    install_name_tool -delete_rpath /usr/local/Cellar/gcc/15.2.0_1/lib/gcc/current $@ 2>/dev/null || true; \
    install_name_tool -delete_rpath /opt/intel/oneapi/tbb/latest/lib $@ 2>/dev/null || true; \
    install_name_tool -delete_rpath /opt/intel/oneapi/mkl/latest/lib $@ 2>/dev/null || true        
    POST_LINK_SIGN = 
#
endif
#
#              setup for macOS, Apple silicon, gfortran
#              ========================================
# 
#              For GNU Fortran builds on macOS Apple Silicon, 
#              the recommended portable target is an explicit Apple core 
#              selection such as -mcpu=apple-m1 for distributed binaries. 
#              Users rebuilding on a known local machine should set -mcpu 
#              to the matching Apple family (apple-m1, apple-m2, apple-m3, 
#              or apple-m4) rather than relying on -mcpu=native.
#
#              The MUMPS libraries are compiled with -mcpu=apple-m1
#              to maintain compatibility with M2, M3, M4, M5, ...

ifeq ($(PLATFORM),silicon)
#   
    ODIR = ././../obj_macOS_silicon
    OD   = ././../obj_macOS_silicon
    EXE_NAME = warp3d_silicon.exe
    MKL :=     # do not include MKL routines
    PARDISO := # do not include Pardiso in MKL
    APPLE = -framework Accelerate 
    #
    #                Define extension for relocatable object code files,
    #                macros for the remove command and the move command.
    #
    O        = .o
    RMC      = rm -f
    MVC      = mv -f
#
    COMPILER = gfortran
#
    MUMPS_LIB  = ../MUMPS_libs/libmumps_all_gfort_osx_arm64_metis.a
    METIS_LINK = -L../MUMPS_libs -lmetis_arm64 -Wl,-rpath,@loader_path/../MUMPS_libs         
#
    ALL_PROCESSORS = -mcpu=apple-m1
    HARDWARE_SPECIFIC = -mcpu=apple-m3   #  for example !
    MACHINE_TYPE =  $(ALL_PROCESSORS)  # $(HARDWARE_SPECIFIC) #$(ALL_PROCESSORS) 

    PRODUCTION = -DOSX -DBuild=$(BUILDNUM) -Dgfortran -I$(OD) -J$(OD) \
      -O3 -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 -fno-strict-overflow \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=overflow,zero -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
      $(MACHINE_TYPE)
    
#   
    DEBUG1 = -DOSX -DBuild=$(BUILDNUM) -Dgfortran -I$(OD) -J$(OD) \
      -O0 -g -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=invalid,zero,overflow -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
       -finit-real=snan -finit-integer=-999999  \
      $(MACHINE_TYPE)
#   
    DEBUG2 = -DOSX -DBuild$(BUILDNUM) -Dgfortran -I$(OD) -J$(OD) \
      -O0 -g -Wno-unused-dummy-argument  -Wno-argument-mismatch \
      -fbacktrace -fmax-errors=1 \
       -Wno-unused-variable -Wno-unused-parameter \
      -Wline-truncation -Wno-unused-label\
      -fno-range-check -Wno-compare-reals \
      -ffpe-trap=overflow,zero -ffpe-summary=none \
      -fallow-argument-mismatch  -fcray-pointer -fopenmp -cpp -fdec \
      -fno-omit-frame-pointer -fcheck=do,mem,pointer \
       -finit-real=snan -finit-integer=-999999  \
      $(MACHINE_TYPE)
#
    OPTS = $(PRODUCTION) -D$(OSNAME) -Darm64
    FOR      = $(COMPILER) $(OPTS)
    LDWARN = -Wl,-w
    LDFLAGS += -Wl,-t
    STATIC_LIBS = -static-libquadmath -static-libgfortran 
    LINK = $(COMPILER) $(PRODUCTION) $(OBJ) $(MUMPS_LIB) $(APPLE) \
       $(STATIC_LIBS)  $(METIS_LINK) $(LDWARN) 
    POST_LINK_SIGN = \
    codesign --force --sign - ../MUMPS_libs/libmetis_arm64.dylib ; \
    codesign --force --sign - $@
    POST_LINK = 
#
endif
#
#               all system level module files that appear as separate *.f
#               in WARP3D
#               => does not include the user routine module .f for Abaqus
#                  compatible routines. see it later down in this file.
#
MODS     := $(OD)/mod_adaptive_steps.o \
			$(OD)/mod_contact.o       \
			$(OD)/mod_crack_growth.o \
			$(OD)/mod_crystals.o \
			$(OD)/mod_damage.o \
			$(OD)/mod_elblk.o \
			$(OD)/mod_eleblocks.o \
			$(OD)/mod_elem_load.o \
			$(OD)/mod_file_info.o \
