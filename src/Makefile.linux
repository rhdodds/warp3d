#
$(EXE_NAME) : $(OBJ)
	$(LINK) $(OBJ) $(LIBS) -o $@
	$(MVC) $@ ./../run_linux/$@
	chmod ugo+rx  ./../run_linux/$@
#
#       ---  default rule to make .o from .f ------
#            ===============================
#
#            => for simplicity we assume all the *.f depend on all
#               modules, includes, param_def
#
$(OD)/%.o : %.f $(MODS) $(INCLUDES)
	$(RMC)  $@
	$(FOR) $< -c -o $@
#        $(FOR) -qopt-report-file=$<.html $< -c -o $@
#
#
#       ---  main_program.f gets special ifort options ------
#            =========================================
#
$(OD)/main_program$O : main_program.f $(MODS) $(INCLUDES)
	$(FOR) -D$(OSNAME) -DBuild=$(BUILDNUM) -fpp  $< -c -o $@
#
#       ---  any .f files that require non-std compile options ------
#            =================================================
#
 $(OD)/mm10_b$O : mm10_b.f  $(MODS) $(INCLUDES) 
	$(RMC)  $@
	$(FOR)  $(NO_INLINE) $< -c -o $@  
#
#       ---  Abaqus compatible user routines. Listed explicitly for clarity ------
#            ==============================================================
#
  $(OD)/user_routines_module$O : user_routines_module.f
	$(RMC)  $@
	$(FOR)  $(NO_INLINE) $< -c -o $@

  $(OD)/user_routines_umat$O : user_routines_umat.f \
              $(OD)/user_routines_module$O $(OD)/mod_user_parms_def$O
	$(RMC)  $@
	$(FOR) $(NO_INLINE)  $< -c -o $@

  $(OD)/user_routines_other_Abaqus$O : user_routines_other_Abaqus.f \
                                     $(OD)/user_routines_module$O
	$(RMC)  $@
	$(FOR) $(NO_INLINE) $< -c -o $@

  $(OD)/user_routines_warp3d$O : user_routines_warp3d.f  \
                               $(OD)/user_routines_module$O \
                               $(OD)/mod_user_parms_def$O
	$(RMC)  $@
	$(FOR)  $(NO_INLINE)  $< -c -o $@

  $(OD)/user_routines_support$O : user_routines_support.f  \
                                $(OD)/user_routines_module$O \
                                $(OD)/mod_user_parms_def$O
	$(RMC)  $@
	$(FOR)  $(NO_INLINE) $< -c -o $@
#
#
#
#    ------   system level module files ----------------
#             =========================
#
$(OD)/mod_adaptive_steps$O : mod_adaptive_steps.f param_def 
	$(RMC)  $@
	$(FOR) $< -c -o $@

$(OD)/mod_contact$O : mod_contact.f param_def 
	$(RMC)  $@
	$(FOR) $< -c -o $@

$(OD)/mod_crack_growth$O : mod_crack_growth.f param_def  \
                             $(OD)/mod_main$O $(OD)/mod_eleblocks$O \
                             $(OD)/mod_damage$O
	$(RMC)  $@
	$(FOR) $< -c -o $@

$(OD)/mod_crystals$O : mod_crystals.f param_def  $(OD)/mod_main$O
	$(RMC)  $@
	$(FOR) $< -c -o $@

$(OD)/mod_damage$O : mod_damage.f param_def 
	$(RMC)  $@
	$(FOR) $< -c -o $@

