$(OD)/mod_mm10_working$O : mod_mm10_working.f param_def  \
                             $(OD)/mod_main$O $(OD)/mod_crystals$O
	$(RMC)  $@
	$(FOR) $< -c -o $@

$(OD)/mod_user_parms_def$O : mod_user_parms_def.f param_def 
	$(RMC)  $@
	$(FOR) $< -c -o $@
	
	
	
	
	
	
